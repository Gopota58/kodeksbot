# ==========================================================================
#  Копируйте этот файл в .env и заполните своими значениями.
#  Полный список настроек — в config.py (класс Settings).
# ==========================================================================

# --- API и доступ ---
# Публичный ключ: открывает ТОЛЬКО /ask. Он же зашит в static/index.html,
# поэтому секретом не является — его видит любой посетитель демо.
# Меняя его, поправьте такую же константу в static/index.html, иначе UI получит 401.
API_KEY=kb_pub_ahMilkR7bgXKaSDs9FKX6hC1
# Админский ключ: /upload, /ingest, /documents, DELETE /documents/{file}.
# В HTML не попадает — вводится вручную в UI (кнопка 🔑). Пусто = используется API_KEY.
ADMIN_API_KEY=СМЕНИТЕ_НА_СЛУЧАЙНУЮ_СТРОКУ

# --- Rate limiting (защита квоты GigaChat на публичном демо) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=30          # /ask на один IP
RATE_LIMIT_ADMIN_PER_MINUTE=10    # /upload, /ingest, /documents на один IP

# --- LLM: GigaChat (Сбер) ---
# 1) Впишите Authorization key из консоли developers.sber.ru в LLM_API_KEY.
# 2) Укажите модель (актуальный id — GET https://api.giga.chat/v1/models):
#    GigaChat-2 — бесплатный Lite-тариф, GigaChat-Pro / GigaChat-Max — платные.
# 3) На Windows нужен "Russian Trusted Root CA" (gosuslugi.ru/crt) — укажите путь
#    в GIGACHAT_CA_BUNDLE_FILE, либо для dev-прогона поставьте VERIFY_SSL_CERTS=false.
LLM_PROVIDER=gigachat
LLM_API_KEY=ВАШ_GIGACHAT_KEY
LLM_MODEL=GigaChat-2
# 0.0 — максимальная детерминированность (юр. ассистенту важнее стабильность).
# Внимание: GigaChat недетерминирован и при 0.0 — см. NOTES.md.
LLM_TEMPERATURE=0.0
LLM_TOP_P=0.9
LLM_MAX_TOKENS=1024
LLM_USE_SYSTEM_PROMPT=true
LLM_MAX_CONTEXT_CHARS=6000
LLM_EXTRA_BODY={}
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_VERIFY_SSL_CERTS=true
# GIGACHAT_CA_BUNDLE_FILE=E:\Project\certs\Russian_Trusted_Root_CA.pem

# --- Эмбеддинги: локальная модель Сбера, СТРОГО offline ---
# Giga-Embeddings-instruct-480M-0826 (1024-dim, SentenceTransformer-формат,
# trust_remote_code). Скачивание из сети отключено (HF_HUB_OFFLINE=1 в config.py) —
# веса должны лежать в models/Giga-Embeddings-instruct-480M-0826.
# Смена модели => обязательная пересборка индекса (python ingest.py).
EMBED_PROVIDER=local
EMBEDDING_MODEL_ID=Giga-Embeddings-instruct-480M-0826
# cuda — локально на GPU; cpu — в Docker-деплое (на ВМ без GPU)
EMBED_DEVICE=cuda

# --- Ретривер и reranker ---
RETRIEVER_K=8
# HyDE: +1 вызов GigaChat на запрос, лучше семантика на «неудачных» формулировках.
# По умолчанию выключен ради скорости.
ENABLE_HYDE=false
# Reranker поверх гибридной выдачи (вектор + BM25 -> RRF).
# all-MiniLM-L6-v2 — быстро (~22M); jina-reranker-v2-base-multilingual — качественнее,
# но на CPU ~2 мин/запрос. Пустая строка = reranker отключён.
RERANK_MODEL=models/all-MiniLM-L6-v2

# --- Корпус документов ---
# Документы лежат в data/docs/ (PDF/DOCX/TXT). Менять обычно не нужно.
# DOCS_DIR=data/docs

# --- CORS (через запятую; * — разрешить все) ---
ALLOWED_ORIGINS=*

# --- Telegram-бот (нужен только для bot.py) ---
# TELEGRAM_BOT_TOKEN=123456789:REPLACE-WITH-YOUR-BOTFATHER-TOKEN
# TELEGRAM_PROXY=http://127.0.0.1:7890
# RAG_API_URL=http://localhost:8000
