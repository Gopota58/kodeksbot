# ==========================================================================
#  Копируйте этот файл в .env и заполните своими значениями.
# ==========================================================================

# --- API ---
# Ключ доступа к эндпоинтам. ОБЯЗАТЕЛЬНО смените в продакшене!
API_KEY=88888888

# --- LLM: GigaChat (Сбер) ---
# 1) Впишите Authorization key из консоли developers.sber.ru в LLM_API_KEY.
# 2) Укажите модель (проверьте актуальный id через GET https://api.giga.chat/v1/models
#    либо в консоли: GigaChat-2 — бесплатный Lite-тариф, GigaChat-Pro / GigaChat-Max — платные).
# 3) На Windows скачайте "Russian Trusted Root CA" (gosuslugi.ru/crt) и укажите путь,
#    либо для быстрого dev-прогона поставьте GIGACHAT_VERIFY_SSL_CERTS=false.
LLM_PROVIDER=gigachat
LLM_API_KEY=ВАШ_GIGACHAT_KEY
LLM_MODEL=GigaChat-2
LLM_TEMPERATURE=0.3
LLM_TOP_P=0.9
LLM_MAX_TOKENS=1024
LLM_USE_SYSTEM_PROMPT=true
LLM_MAX_CONTEXT_CHARS=6000
LLM_EXTRA_BODY={}
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_VERIFY_SSL_CERTS=true
# GIGACHAT_CA_BUNDLE_FILE=C:\Project\certs\russian_trusted_root_ca.crt

# --- Эмбеддинги: локальная русскоязычная модель (offline, тянется из HF при 1-м запуске) ---
# rubert-tiny2 — быстрая, неплохой русский. Для максимального качества:
#   EMBEDDING_MODEL_ID=ai-forever/sbert_large_nlu_ru  (точнее, ~1.2 ГБ)
# (all-MiniLM-L6-v2 из запасов фреймворка лежит в models/, но слабее для русского)
EMBED_PROVIDER=local
EMBEDDING_MODEL_ID=cointegrated/rubert-tiny2

# --- Корпус документов ---
# Документы лежат в data/docs/ (PDF/DOCX/TXT). Менять обычно не нужно.
# DOCS_DIR=data/docs

# --- CORS (через запятую; * — разрешить все) ---
ALLOWED_ORIGINS=*

# --- Telegram-бот (нужен только для bot.py) ---
# TELEGRAM_BOT_TOKEN=123456789:REPLACE-WITH-YOUR-BOTFATHER-TOKEN
# TELEGRAM_PROXY=http://127.0.0.1:7890
# RAG_API_URL=http://localhost:8000
